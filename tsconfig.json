{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "lib": ["DOM", "DOM.Iterable", "ESNext"],
      "baseUrl": ".",

      "paths": {
        "@": [""],
        "shadcn": ["assets/shadcn"],
        "utils": ["assets/shadcn/lib/utils"],
        "components": ["assets/shadcn/components"],
        "ui": ["assets/shadcn/ui"],
        "lib": ["assets/shadcn/lib"],
        "hooks": ["assets/shadcn/hooks"],
      },

      "jsx": "react-jsx",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "noEmit": true
    },
    "include": [
      "./**/*"
    ],
    "exclude": ["node_modules"]
  }